<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="400.0" prefWidth="600.0"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.CreateTicket">

    <children>
        <ComboBox fx:id="eventIdComboBox" layoutX="167.0" layoutY="53.0" promptText="Choisissez un événement"/>
        <TextField fx:id="emailField" layoutX="167.0" layoutY="122.0" />
        <TextField fx:id="nomField" layoutX="161.0" layoutY="241.0" />

        <Text layoutX="41.0" layoutY="70.0" text="ID Événement" />
        <Text layoutX="77.0" layoutY="139.0" text="Email" />
        <Text layoutX="78.0" layoutY="258.0" text="Nom" />

        <Button fx:id="createBtn" layoutX="248.0" layoutY="337.0" text="Créer Ticket" />

        <Text layoutX="58.0" layoutY="205.0" text="Date d'achat" />
        <DatePicker fx:id="purchaseDatePicker" layoutX="161.0" layoutY="188.0" />
    </children>
</AnchorPane>