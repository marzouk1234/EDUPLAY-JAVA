<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="600.0" prefWidth="900.0" style="-fx-background-color: #f0f0f0;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.AfficherForm_pController">
    <children>
        <VBox alignment="CENTER" layoutX="20.0" layoutY="20.0" prefHeight="560.0" prefWidth="860.0" spacing="15.0">
            <children>
                <Label text="Liste des Formulaires" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                
                <TableView fx:id="formTable" prefHeight="400.0" prefWidth="860.0">
                    <columns>
                        <TableColumn fx:id="idColumn" prefWidth="50.0" text="ID" />
                        <TableColumn fx:id="sujetColumn" prefWidth="200.0" text="Sujet" />
                        <TableColumn fx:id="contenuColumn" prefWidth="300.0" text="Contenu" />
                        <TableColumn fx:id="dateColumn" prefWidth="120.0" text="Date de Publication" />
                        <TableColumn fx:id="auteurColumn" prefWidth="150.0" text="Auteur" />
                    </columns>
                </TableView>
                
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="ajouterButton" mnemonicParsing="false" onAction="#handleAjouter" 
                                prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #4CAF50; -fx-text-fill: white;" text="Ajouter">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="modifierButton" mnemonicParsing="false" onAction="#handleModifier" 
                                prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Modifier">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button fx:id="supprimerButton" mnemonicParsing="false" onAction="#handleSupprimer" 
                                prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Supprimer">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane> 