<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.FeedbackStatistics"
            prefHeight="500.0" prefWidth="700.0">

    <VBox alignment="CENTER" spacing="20.0" prefWidth="700" prefHeight="500"
          AnchorPane.topAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0">

        <PieChart fx:id="pieChart" prefHeight="400.0" prefWidth="600.0" />

        <Button text="Return to Feedback View" fx:id="btnReturn" onAction="#loadFeedbackView"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-background-radius: 8;"
                prefWidth="200" prefHeight="40" />
    </VBox>

</AnchorPane>
