<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<BorderPane prefHeight="600.0" prefWidth="800.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.AideController"
            stylesheets="@style.css"
            styleClass="root">

    <!-- Top Bar -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT" styleClass="top-bar" BorderPane.alignment="TOP_LEFT">
            <Label text="Liste des Aides" styleClass="title-label"/>
            <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="200"/>
            <Region fx:id="spacer" HBox.hgrow="ALWAYS"/>
            <Button fx:id="ajouterAideBtn" onAction="#handleAjouterAide" text="Ajouter une aide" styleClass="button"/>
            <Button fx:id="modifierAideBtn" onAction="#handleModifierAide" text="Modifier une aide" styleClass="button"/>
            <Button fx:id="supprimerAideBtn" onAction="#handleSupprimerAide" text="Supprimer une aide" styleClass="button"/>
            <Button fx:id="refreshBtn" onAction="#handleRefresh" text="Actualiser" styleClass="button"/>
        </HBox>
    </top>

    <!-- TableView Center -->
    <center>
        <TableView fx:id="aideTable" prefHeight="500" prefWidth="760" tableMenuButtonVisible="true"
                   BorderPane.alignment="CENTER" styleClass="table-view">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="sujetColumn" text="Sujet" prefWidth="150"/>
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200"/>
                <TableColumn fx:id="dateCreationColumn" text="Date de création" prefWidth="150"/>
                <TableColumn fx:id="formSujetColumn" text="Formulaire associé" prefWidth="150"/>
            </columns>
        </TableView>
    </center>

    <!-- Bottom Bar (Optional for Status Label) -->
    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" styleClass="bottom-bar">
            <Label fx:id="statusLabel" styleClass="status-label"/>
        </HBox>
    </bottom>

</BorderPane>