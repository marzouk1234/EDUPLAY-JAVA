<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AideController"
            prefHeight="600.0" prefWidth="800.0">
    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" 
          AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        
        <Label text="Liste des Aides" styleClass="title-label" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
        
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Button text="Ajouter" onAction="#handleAjouterAide" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            <Button text="Modifier" onAction="#handleModifierAide" style="-fx-background-color: #2196F3; -fx-text-fill: white;"/>
            <Button text="Supprimer" onAction="#handleSupprimerAide" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="200"/>
        </HBox>
        
        <TableView fx:id="aideTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                <TableColumn fx:id="sujetColumn" text="Sujet" prefWidth="150"/>
                <TableColumn fx:id="descriptionColumn" text="Description" prefWidth="200"/>
                <TableColumn fx:id="dateCreationColumn" text="Date de création" prefWidth="150"/>
                <TableColumn fx:id="formSujetColumn" text="Formulaire associé" prefWidth="200"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
        </TableView>
        
        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label fx:id="statusLabel" style="-fx-text-fill: #666;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Actualiser" onAction="#handleRefresh" style="-fx-background-color: #607D8B; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</AnchorPane> 