<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="425.0" prefWidth="634.0" xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controller.EventController">
   <children>
      <ListView fx:id="eventsListView" layoutX="43.0" layoutY="85.0" prefHeight="282.0" prefWidth="549.0" />
      <Text fill="#e18181" layoutX="191.0" layoutY="57.0" strokeType="OUTSIDE" strokeWidth="0.0" text="Liste Des Événements">
         <font>
            <Font size="27.0" />
         </font>

      </Text>
      <Button fx:id="mod" layoutX="520.0" layoutY="376.0" mnemonicParsing="false"
              prefHeight="25.0" prefWidth="80.0" text="Modifier" onAction="#handleModifyEvent" />
      <Button fx:id="tk" layoutX="261.0" layoutY="389.0" mnemonicParsing="false"
              prefHeight="25.0" prefWidth="157.0" text="Voir Le ticket" />
      <Button fx:id="supp" layoutX="53.0" layoutY="376.0" mnemonicParsing="false"
              prefHeight="25.0" prefWidth="80.0" text="Supprimer" onAction="#handleDeleteEvent" />
   </children>
</AnchorPane>