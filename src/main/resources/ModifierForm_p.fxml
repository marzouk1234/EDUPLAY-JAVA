<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane fx:id="rootPane" prefHeight="500.0" prefWidth="700.0" style="-fx-background-color: #f0f0f0;"
            xmlns="http://javafx.com/javafx/23.0.1"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="Controllers.ModifierForm_pController">
    <children>
        <VBox alignment="CENTER" layoutX="50.0" layoutY="30.0" prefHeight="440.0" prefWidth="600.0" spacing="20.0">
            <children>
                <Label text="Modifier le Formulaire" textAlignment="CENTER">
                    <font>
                        <Font name="System Bold" size="24.0" />
                    </font>
                </Label>
                
                <VBox spacing="10.0">
                    <children>
                        <Label text="ID:" styleClass="form-label">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="idField" editable="false" style="-fx-background-color: #e0e0e0;" />
                    </children>
                </VBox>
                
                <VBox spacing="10.0">
                    <children>
                        <Label text="Sujet:" styleClass="form-label">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="sujetField" promptText="Entrez le sujet du formulaire" />
                    </children>
                </VBox>
                
                <VBox spacing="10.0">
                    <children>
                        <Label text="Contenu:" styleClass="form-label">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="contenuField" prefHeight="100.0" promptText="Entrez le contenu du formulaire" />
                    </children>
                </VBox>
                
                <VBox spacing="10.0">
                    <children>
                        <Label text="Date de publication:" styleClass="form-label">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <DatePicker fx:id="datePicker" prefWidth="600.0" promptText="Sélectionnez une date" />
                    </children>
                </VBox>
                
                <VBox spacing="10.0">
                    <children>
                        <Label text="Auteur:" styleClass="form-label">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Label>
                        <TextField fx:id="auteurField" promptText="Entrez le nom de l'auteur" />
                    </children>
                </VBox>
                
                <HBox alignment="CENTER" spacing="20.0">
                    <children>
                        <Button fx:id="submitButton" mnemonicParsing="false" onAction="#handleUpdateSubmission" 
                                prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #2196F3; -fx-text-fill: white;" text="Mettre à jour">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                        <Button mnemonicParsing="false" onAction="#handleCancelButton" 
                                prefHeight="40.0" prefWidth="150.0" style="-fx-background-color: #f44336; -fx-text-fill: white;" text="Annuler">
                            <font>
                                <Font name="System Bold" size="14.0" />
                            </font>
                        </Button>
                    </children>
                    <padding>
                        <Insets top="20.0" />
                    </padding>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
        </VBox>
    </children>
</AnchorPane> 