<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.AjouterAideController"
            prefHeight="450.0" prefWidth="600.0"
            stylesheets="@style.css"
            styleClass="root">

    <VBox spacing="15" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20"
          AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

        <Label text="Ajouter une aide" styleClass="form-title"/>

        <GridPane vgap="15" hgap="10">
            <Label text="Sujet:" GridPane.rowIndex="0" GridPane.columnIndex="0" styleClass="form-label"/>
            <TextField fx:id="sujetField" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       prefWidth="300" promptText="Entrez le sujet de l'aide" styleClass="form-field"/>

            <Label text="Description:" GridPane.rowIndex="1" GridPane.columnIndex="0" styleClass="form-label"/>
            <TextArea fx:id="descriptionArea" wrapText="true" prefRowCount="5"
                      GridPane.rowIndex="1" GridPane.columnIndex="1"
                      promptText="Entrez la description de l'aide" styleClass="form-field"/>

            <Label text="Formulaire associé:" GridPane.rowIndex="2" GridPane.columnIndex="0" styleClass="form-label"/>
            <ComboBox fx:id="formComboBox" prefWidth="300"
                      GridPane.rowIndex="2" GridPane.columnIndex="1"
                      promptText="Sélectionnez un formulaire" styleClass="form-field"/>
        </GridPane>

        <Region VBox.vgrow="ALWAYS"/>

        <HBox spacing="10" alignment="CENTER_RIGHT">
            <Label fx:id="messageLabel" styleClass="status-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Annuler" onAction="#handleAnnuler" styleClass="cancel-button"/>
            <Button text="Enregistrer" onAction="#handleEnregistrer" styleClass="save-button"/>
        </HBox>
    </VBox>
</AnchorPane>
