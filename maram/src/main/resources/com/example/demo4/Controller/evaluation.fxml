<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane id="AnchorPane" prefHeight="550.0" prefWidth="369.0" xmlns="http://javafx.com/javafx/17.0.2-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.demo4.Controller.evaluationController">
   <children>
      <ImageView fx:id="imageview" fitHeight="114.0" fitWidth="254.0" layoutX="30.0" layoutY="15.0" pickOnBounds="true" preserveRatio="true" />

      <Label fx:id="titreevLabel" layoutX="29.0" layoutY="140.0" prefHeight="24.0" prefWidth="250.0" text="Titre Evalauation">
         <font>
            <Font name="Lucida Bright" size="14.0" />
         </font>
      </Label>

      <Label fx:id="typeLabel" layoutX="29.0" layoutY="190.0" prefHeight="24.0" prefWidth="250.0" text="Type" />
      <Label fx:id="dateLabel" layoutX="29.0" layoutY="215.0" prefHeight="24.0" prefWidth="250.0" text="Date Début" />


      <Label layoutX="29.0" layoutY="315.0" text="Début resultat:" />

      <DatePicker fx:id="startDatePicker" layoutX="130.0" layoutY="310.0" prefWidth="180.0" />
      <Label layoutX="32.0" layoutY="351.0" text="Note resultat:" />

      <TextField fx:id="noteField" layoutX="130.0" layoutY="347.0" prefHeight="25.0" prefWidth="180.0" />

      <Button fx:id="addResultatButton" layoutX="14.0" layoutY="454.0" mnemonicParsing="false" onMouseClicked="#addResultat" prefHeight="26.0" prefWidth="290.0" style="-fx-background-radius: 30;" text="Ajout resultat" textFill="#41c91b">
         <font>
            <Font name="Bowlby One SC Regular" size="18.0" />
         </font>
      </Button>
      <Hyperlink fx:id="voirResultatsLink" layoutX="23.0" layoutY="420.0" onAction="#voirResultats" prefHeight="23.0" prefWidth="342.0" text="Voir les resultats liées" />


      <!-- Champs cachés -->
      <TextField fx:id="idevF" layoutX="264.0" layoutY="270.0" opacity="0.0" prefHeight="0.0" prefWidth="2.0" />
      <TextField fx:id="iduserF" layoutX="10.0" layoutY="450.0" opacity="0.0" />
      <TextField fx:id="idPartField" layoutX="10.0" layoutY="460.0" opacity="0.0" prefHeight="32.0" prefWidth="0.0" />
      <TextField fx:id="fullnameevField" layoutX="256.0" layoutY="265.0" opacity="0.0" prefHeight="25.0" prefWidth="0.0" />
      <TextField fx:id="appreciationevField" layoutX="249.0" layoutY="478.0" opacity="0.0" prefHeight="25.0" prefWidth="0.0" />
      <Button fx:id="annulerButton" layoutX="10.0" layoutY="490.0" opacity="0.0" />
   </children>
</AnchorPane>
