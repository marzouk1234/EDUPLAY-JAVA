<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.geometry.Pos?>
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="Controllers.DashboardController"
            stylesheets="@style.css">

    <!-- Sidebar -->
    <left>
        <VBox spacing="20" alignment="TOP_LEFT" style="-fx-background-color: #2C3E50; -fx-padding: 20;">
            <children>
                <!-- Logo -->
                <ImageView fitHeight="100" fitWidth="100" styleClass="image-view">
                    <image>
                        <Image url="@/images/logo.png"/>
                    </image>
                </ImageView>

                <!-- Titre -->
                <Label text="Bienvenue chez EDUPLAY" style="-fx-text-fill: white; -fx-font-size: 20px;"/>

                <!-- Boutons -->
                <Button text="Home" styleClass="button"/>
                <Button text="Liste des Inscriptions" onAction="#goToListeInscriptions" styleClass="button"/>
                <Button text="Liste des Cours" onAction="#goToListeCours" styleClass="button"/>
                <Button text="Liste des Cours (back)" onAction="#goToListeCoursback" styleClass="button"/>
                <Button text="Liste des Evaluations" styleClass="button"/>
                <Button text="Liste des Resultats" styleClass="button"/>
                <Button text="Liste des jeux" styleClass="button"/>
                <Button text="Chatbot" onAction="#showChatbot" styleClass="button"/>
            </children>
        </VBox>
    </left>

    <!-- Zone centrale dynamique -->
    <center>
        <StackPane fx:id="mainContainer">
            <!-- Contenu principal par défaut -->
            <AnchorPane fx:id="contentPane" prefWidth="600.0" prefHeight="600.0"/>

            <!-- Interface du chatbot (chargée dynamiquement) -->
            <fx:include fx:id="chatbotContainer" source="chat.fxml" visible="false"/>
        </StackPane>
    </center>

</BorderPane>